{
  "name": "vinyl-bot-tgcloud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "description": "Telegram Serverless port of the Vinyl Bot Python backend",
  "scripts": {
    "check": "node scripts/check-serverless.mjs && node --experimental-vm-modules --test tests/serverless/*.test.mjs tests/video/*.test.mjs",
    "check:behavior": "node --experimental-vm-modules --test tests/serverless/flows.test.mjs",
    "prepare:video-probe": "node scripts/prepare-video-probe.mjs",
    "prepare:legacy-import": "node scripts/prepare-legacy-import.mjs",
    "status": "tgcloud status",
    "deploy": "tgcloud push",
    "migrate": "tgcloud migrate",
    "check:syntax": "node scripts/check-serverless.mjs",
    "check:parity": "node --test tests/serverless/main-parity.test.mjs",
    "prepare:wasm-probe": "node scripts/prepare-wasm-encoder-probe.mjs"
  },
  "devDependencies": {
    "@tgcloud/cli": "0.2.0"
  }
}
